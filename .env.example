# Nowa baza Neon tylko dla sun.support — nie wklejaj connection stringa z logistics.
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
NEON_DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# min. 32 znaki
BETTER_AUTH_SECRET=zmien-na-losowy-sekret-min-32-znaki-xxxx
BETTER_AUTH_URL=http://localhost:3000

# Opcjonalnie: email:rola,email:rola — role: admin | lead | agent.
# Bez hardcoded maili w repo. Docelowo zespół tylko w bazie (strona /team).
# AUTH_ALLOWLIST=imie.nazwisko@sun.store:admin

# Link „otwórz w logistics” (tylko odczyt)
LOGISTICS_APP_URL=https://sun-logistics.vercel.app

# Better Auth + Google (jak logistics). Przycisk gdy jest GOOGLE_CLIENT_ID.
# Redirect: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Lokalnie za firmowym proxy (self-signed w łańcuchu do Google). Nigdy na Vercel.
# CORP_TLS_INSECURE=1

# Microsoft Entra — opcjonalny zapas
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=

# Żywy mail z Outlooka (docs/OUTLOOK-MAIL.md). Osobna aplikacja Entra: Mail.Read + Mail.Send (application),
# zawężona do skrzynki CS. Bez tych zmiennych odpowiedzi tylko zapisują się w sprawie.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# OUTLOOK_MAILBOX=
# Vercel Cron wysyła Authorization: Bearer <CRON_SECRET>. Min. 32 znaki.
# CRON_SECRET=

# Aircall → oddzwoń (docs/AIRCALL.md). Token z payloadu webhooka.
# AIRCALL_WEBHOOK_TOKEN=
